root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,css,scss,ts,js,mjs,cjs,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline:suggestion

# Language
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
csharp_prefer_static_local_function = true:suggestion

# Naming: _camelCase private fields
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = readonly
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# ...but private static readonly fields are constant-like: PascalCase (more specific rule wins)
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Unused usings are lint failures (dotnet format --verify-no-changes in CI)
dotnet_diagnostic.IDE0005.severity = warning

# EF Core migrations are generated code
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none

# House rule: GlobalUsings.cs lists one line per project folder, used yet or not
[**/GlobalUsings.cs]
dotnet_diagnostic.IDE0005.severity = none
