# .NET build output
bin/
obj/
artifacts/
TestResults/
*.nupkg
*.snupkg

# Front end (src/Web keeps its own Angular .gitignore as well)
node_modules/
.angular/
dist/
out-tsc/
coverage/
.eslintcache
.npm/

# IDE
.vs/
.idea/
*.iml
.fleet/
*.user
*.suo
*.rsuser
*.DotSettings.user
_ReSharper*/
.vscode/*
!.vscode/extensions.json
.history/
*.swp
*~

# Logs (the Serilog file sink writes here)
logs/
*.log

# Local secrets. Committed appsettings.json files carry local, non-secret values only.
# Real local secrets live in user-secrets, or in .secrets/ for Docker Compose
# (generated by scripts/init-local-secrets). appsettings.*.example.json IS committed.
appsettings.Development.json
!appsettings.Development.example.json
.secrets/
.env
.env.*
!.env.example
*.pfx
*.p12

# Docker: per-machine overrides of compose.yaml
compose.override.yaml
compose.override.yml
docker-compose.override.yml

# QA test environment (scripts/qa-env.ps1): an exported commit with its own generated secrets
.qa-env/

# OS noise
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
