<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared plumbing every Reporting Tool service needs: logging, the error boundary, vault
       secrets, health checks, UTC persistence, time zones and migrations. Services reference this project
       instead of copying the same files, so a fix lands in every service at once. -->
  <PropertyGroup>
    <RootNamespace>ReportingTool.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Expressions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReportingTool.Platform.Tests" />
  </ItemGroup>

</Project>
