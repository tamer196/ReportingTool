{
  "Serilog": {
    "WriteTo": [
      {
        "Args": {
          "configure": [
            {
              "Args": {
                "formatter": {
                  "template": "{ {@t: UtcDateTime(@t), @l: @l, @mt: @mt, @m: @m, @x: @x, @tr: @tr, @sp: @sp, ..@p} }\n"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "Secrets": {
    "Required": true
  }
}
