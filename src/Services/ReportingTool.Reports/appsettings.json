{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": {
                  "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                  "template": "[{@t:HH:mm:ss} {@l:u3}] {@m}\n{@x}"
                }
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Secrets": {
    "Directory": "/run/secrets",
    "Required": false
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 120,
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "Issuer": "http://localhost:8080/auth/realms/reporting-tool",
    "MetadataAddress": "http://keycloak:8080/auth/realms/reporting-tool/.well-known/openid-configuration",
    "Audience": "rt-api",
    "RequireHttpsMetadata": false
  },
  "Rendering": {
    "ChromiumPath": "/usr/bin/chromium",
    "QpdfPath": "/usr/bin/qpdf",
    "WorkDirectory": "/tmp/rt-render",
    "ChunkRowTarget": 6000,
    "MaxPdfPages": 2000,
    "MaxConcurrentRenders": 2,
    "BrowserRecycleAfterRenders": 50,
    "ChunkTimeoutSeconds": 300
  },
  "OutputStorage": {
    "Directory": "/data/outputs"
  }
}
