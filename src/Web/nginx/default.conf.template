# Serves the Angular build and forwards /api/ to the API, so the browser only ever talks to one
# origin (no CORS). The nginx image renders this template at start-up and substitutes only the
# variables present in the container environment: ${API_UPSTREAM} (not a secret, e.g.
# http://api:8080). nginx's own variables ($host, $uri, ...) are left alone.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "Healthy";
    }

    # RT-108 PoC: OIDC settings for the SPA come from the container environment, so one image
    # serves every environment (D-15 "deployable anywhere").
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-cache" always;
        return 200 '{"authority":"${OIDC_AUTHORITY}","clientId":"${OIDC_CLIENT_ID}"}';
    }

    # RT-108 PoC: the Reports service. nginx resolves "reports" to every replica at start-up and
    # round-robins between them (gate G5).
    location /api/reports/ {
        proxy_pass ${REPORTS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 5m;
    }

    # RT-108 PoC: Keycloak (KC_HTTP_RELATIVE_PATH=/auth) on the same origin, so the stack needs
    # one host port. "^~" stops the static-file regex below from catching Keycloak's own assets.
    # Its login responses carry large cookies, hence the bigger header buffers.
    location ^~ /auth/ {
        proxy_pass ${KEYCLOAK_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html must never be cached, so a new deployment is picked up on the next load.
    # Hashed bundles can be cached for a year.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routes fall back to the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
